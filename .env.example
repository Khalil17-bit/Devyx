# Devyx Platform Environment Variables
# Copy to .env.local for local development

# ==============================================================================
# Supabase Configuration (Free Tier PostgreSQL, Auth, Storage)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# ==============================================================================
# n8n AI Lead Qualification & Workflow Webhooks
# ==============================================================================
# Upstream n8n AI webhook for conversational lead qualification (/api/chat)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat-agent
N8N_WEBHOOK_SECRET=your-shared-n8n-secret-token

# Instant alerting webhook for new consultation form submissions (optional)
N8N_LEAD_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-alert

# ==============================================================================
# Security & Rate Limiting
# ==============================================================================
# Salt string used for SHA-256 IP hashing in PostgreSQL rate limit RPC
RATE_LIMIT_SALT=devyx_super_secret_salt_2026_change_in_production

# Secret required by Vercel Cron to trigger /api/cron/keep-alive
CRON_SECRET=devyx_cron_keep_alive_secret_2026

# Redis Concurrency & Token Budget (Local Docker or Upstash/Redis Cloud in Production)
REDIS_URL=rediss://default:your-token@your-upstash-redis.upstash.io:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ==============================================================================
# Public Site Configuration
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Multi-Tier AI Provider Keys (Gemini Vision + Groq LPU)
# ==============================================================================
# Google Gemini API Keys (Used for Multimodal Vision & Fallback Generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY_SECONDARY=your-secondary-gemini-api-key

# Groq LPU API Keys (Used for sub-400ms ultra-fast inference)
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_SECONDARY=your-secondary-groq-api-key

# ==============================================================================
# Telegram Admin Fallback & Human Escalation
# ==============================================================================
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Telegram Admin Group Chat ID (e.g. -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=your-telegram-group-chat-id
